{
  "name": "vault",
  "productName": "Vault",
  "version": "1.0.0",
  "description": "Notas en Markdown con editor tipo Notion",
  "author": "Vault",
  "private": true,
  "type": "module",
  "main": "app/desktop/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/server.mjs",
    "desktop": "electron .",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "electron-builder --win",
    "test": "node --test \"app/test/*.test.mjs\"",
    "art": "electron scripts/make-tutorial-art.mjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.vault.notes",
    "productName": "Vault",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "!app/test/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vault"
    },
    "portable": {
      "artifactName": "Vault-${version}-portable.exe"
    }
  }
}
